# Keep real credentials only in hosting provider secret/environment settings.
TELEGRAM_BOT_TOKEN=
OWNER_CHAT_ID=
# Render supplies RENDER_EXTERNAL_URL automatically; otherwise set this public HTTPS origin.
PUBLIC_BASE_URL=
# Optional: omit to derive a stable server-only secret from TELEGRAM_BOT_TOKEN.
WEBHOOK_SECRET=
TELEGRAM_API_BASE=https://api.telegram.org
MAX_UPLOAD_MB=49
BOT_STATE_FILE=/data/k2app-telegram.sqlite3
PORT=10000
LOG_LEVEL=INFO

# Polling CLI only: set a random 20+ character code instead of OWNER_CHAT_ID.
# BOT_SETUP_CODE=
