# Put the real token only in the hosting provider's secret/environment settings.
TELEGRAM_BOT_TOKEN=
TELEGRAM_API_BASE=https://api.telegram.org
MAX_UPLOAD_MB=49
BOT_STATE_FILE=/data/k2app-telegram.sqlite3

# Choose one: pre-authorize your private chat ID, or use a random setup code (20+ characters)
# OWNER_CHAT_ID=
BOT_SETUP_CODE=

# Only set true for a trusted local/private Bot API server using HTTP.
ALLOW_HTTP_LOCAL_API=false
