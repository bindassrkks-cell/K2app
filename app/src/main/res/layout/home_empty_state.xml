<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/home_empty_state"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_gravity="center"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp"
    android:visibility="gone">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:cardBackgroundColor="@color/k2_ui_accent_container"
        app:cardCornerRadius="36dp"
        app:cardElevation="0dp">

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="@string/ui_home_empty_message"
            android:padding="20dp"
            android:src="@drawable/ic_link"
            app:tint="@color/k2_ui_accent" />
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:text="@string/ui_ready_when_you_are"
        android:textColor="@color/k2_ui_text_primary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:maxWidth="360dp"
        android:text="@string/ui_home_empty_message"
        android:textColor="@color/k2_ui_text_secondary"
        android:textSize="14sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_empty_paste"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="22dp"
        android:text="@string/ui_paste_link"
        android:textColor="@color/k2_ui_on_accent"
        android:textStyle="bold"
        app:backgroundTint="@color/k2_ui_accent"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_clipboard"
        app:iconTint="@color/k2_ui_on_accent" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/home_empty_search"
        style="?attr/materialButtonOutlinedStyle"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="10dp"
        android:text="@string/ui_search_a_title"
        android:textColor="@color/k2_ui_text_primary"
        app:cornerRadius="14dp"
        app:icon="@drawable/ic_search"
        app:iconTint="@color/k2_ui_accent"
        app:strokeColor="@color/k2_ui_outline" />
</LinearLayout>
